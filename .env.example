# Database
# Para desarrollo local con PostgreSQL:
DATABASE_URL=postgresql://usuario:password@localhost:5432/didaktikapp
# Para Railway (automáticamente provisto):
# DATABASE_URL=postgresql://user:password@host:port/database

# Security
SECRET_KEY=tu-clave-secreta-super-segura-cambiala
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Key para acceso administrativo
# Genera una clave segura con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=tu-api-key-generada-aleatoriamente

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=GerniBide API

# CORS Configuration
# Para desarrollo (permite todos los orígenes):
CORS_ORIGINS=*
# Para producción (especifica dominios permitidos, separados por comas):
# CORS_ORIGINS=https://tuapp.com,https://www.tuapp.com,https://admin.tuapp.com
# Nota: Apps Android nativas NO necesitan estar en esta lista (CORS solo aplica a navegadores web)
